# Copy this file to .env on the machine hosting the MCP server.
# MCP endpoint settings (all URLs, ports and server name live here).
MCP_TRANSPORT=streamable-http
MCP_ENVIRONMENT=development
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PUBLIC_URL=http://localhost:8000
MCP_SERVER_NAME=openproject
MCP_PATH=/mcp
# Public hostname used by MCP. Set MCP_ALLOWED_ORIGINS only if a browser client needs CORS.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
MCP_ALLOWED_ORIGINS=

# OpenProject 17.9.1 base URL.
OPENPROJECT_BASE_URL=https://openproject.example.com

# For local stdio only. Remote HTTP users send their own token from Codex.
OPENPROJECT_API_TOKEN=
OPENPROJECT_VERIFY_SSL=true
OPENPROJECT_TIMEOUT=12
OPENPROJECT_LOG_LEVEL=WARNING
# Central audit trail: one JSON event per MCP tool call, rotated at this size.
MCP_AUDIT_LOG_FILE=logs/audit.jsonl
MCP_AUDIT_LOG_MAX_BYTES=10485760
MCP_AUDIT_LOG_BACKUP_COUNT=5
OPENPROJECT_ENABLE_GENERIC_API=true

# Optional planned-budget vs actual-cost comparison. PostgreSQL is read only.
# Keep these unset unless explicitly enabling this isolated feature.
OPENPROJECT_BUDGET_COMPARISON_ENABLED=false
OPENPROJECT_DB_TYPE=postgresql
OPENPROJECT_DB_HOST=
OPENPROJECT_DB_PORT=5432
OPENPROJECT_DB_NAME=
OPENPROJECT_DB_USER=
OPENPROJECT_DB_PASSWORD=
OPENPROJECT_DB_SSLMODE=verify-full
